msgstr "Tema"

#: src/core/installer.py:95 src/core/installer.py:132 src/pages/cursor.py:29
#: src/pages/overview.py:88 src/window.py:73
msgid "Cursor"
msgstr "Cursor"

#: src/core/installer.py:96 src/core/installer.py:130 src/pages/icons.py:29
#: src/pages/overview.py:86 src/window.py:71
msgid "Icons"
msgstr "Iconos"

#: src/core/installer.py:122
msgid "Extension"
msgstr "Extensión"

#: src/core/installer.py:213
msgid "The file was not found."
msgstr "No se encontró el archivo."

#: src/core/installer.py:221
msgid ""
"7z and rar archives are not supported. Extract it first and drop the folder "
"instead."
msgstr ""
"Los archivos 7z y rar no son compatibles. Extráelo primero y arrastra la "
"carpeta."

#: src/core/installer.py:252
msgid ""
"This folder contains too many themes. Drop the folder of the theme itself."
msgstr ""
"Esta carpeta contiene demasiados temas. Arrastra la carpeta del propio tema."

#: src/core/installer.py:271 src/core/installer.py:455
msgid "The archive is too large to unpack safely."
msgstr ""
"El archivo comprimido es demasiado grande para extraerlo de forma segura."

#: src/core/installer.py:290
msgid ""
"This is a Windows cursor (.cur/.ani). GNOME cannot use it directly. Download "
"the Linux variant of the theme (a folder with a \"cursors\" subfolder)."
msgstr ""
"Este es un cursor de Windows (.cur/.ani). GNOME no puede usarlo "
"directamente. Descarga la variante Linux del tema (una carpeta con una "
"subcarpeta \"cursors\")."

#: src/core/installer.py:294
msgid ""
"This is a login screen (GDM) theme. It replaces system files and can lock "
"you out, so it is not installed. For a custom login background use "
"Background > Login screen."
msgstr ""
"Es un tema para la pantalla de inicio de sesión (GDM). Sustituye archivos "
"del sistema y puede dejarte sin acceso, por eso no se instala. Para un fondo "
"propio usa Fondo > Pantalla de inicio de sesión."

#: src/core/installer.py:298
msgid ""
"This is a boot splash (Plymouth) theme. Installing it rebuilds the boot "
"image as root, so it is not supported."
msgstr ""
"Es un tema de pantalla de arranque (Plymouth). Instalarlo reconstruye la "
"imagen de arranque como root, por eso no es compatible."

#: src/core/installer.py:301
msgid ""
"This is a boot menu (GRUB) theme. It changes the boot loader as root, so it "
"is not supported."
msgstr ""
"Es un tema para el menú de arranque (GRUB). Modifica el gestor de arranque "
"como root, por eso no es compatible."

#: src/core/installer.py:304
msgid ""
"This is a theme for the Plank or Latte dock. Ubuntu Dock and Dash to Panel "
"cannot use it."
msgstr ""
"Es un tema para el dock Plank o Latte. Ubuntu Dock y Dash to Panel no pueden "
"usarlo."

#: src/core/installer.py:308
msgid ""
"Nothing installable found (no theme, icons, cursor, font, extension or "
"wallpaper)."
msgstr ""
"No se encontró nada instalable (ni tema, ni iconos, ni cursor, ni "
"tipografía, ni extensión, ni fondo)."

#: src/core/installer.py:378
msgid ""
"Format not supported. Use a .zip or .tar archive, a font, an image or an "
"extracted theme folder."
msgstr ""
"Formato no compatible. Usa un archivo comprimido .zip o .tar, una "
"tipografía, una imagen o una carpeta de tema extraída."

#: src/core/installer.py:383
msgid "The archive could not be extracted."
msgstr "No se pudo extraer el archivo comprimido."

#: src/core/installer.py:457
msgid "Not enough free disk space to unpack the archive."
msgstr ""
"No hay suficiente espacio libre en disco para extraer el archivo comprimido."

#: src/core/installer.py:470 src/core/installer.py:485
msgid "The archive contains unsafe paths."
msgstr "El archivo comprimido contiene rutas no seguras."

#: src/core/installer.py:660
msgid ""
"This is the source code of a theme and has to be built first. Download a "
"ready-made release package instead."
msgstr ""
"Es el código fuente de un tema y primero hay que compilarlo. Descarga en su "
"lugar un paquete de versión ya listo."

#: src/core/installer.py:664
#, python-brace-format
msgid ""
"\"{name}\" would replace a built-in system theme and was skipped for safety."
msgstr ""
"\"{name}\" sustituiría un tema integrado del sistema y se omitió por "
"seguridad."

#: src/core/installer.py:700 src/core/installer.py:705
msgid "The extension has no valid metadata.json."
msgstr "La extensión no tiene un metadata.json válido."

#: src/core/installer.py:708
#, python-brace-format
msgid "\"{name}\" is a system extension and was skipped."
msgstr "\"{name}\" es una extensión del sistema y se omitió."

#: src/core/installer.py:731
#, python-brace-format
msgid "Extension: {name} (made for GNOME {versions}, may not load)"
msgstr "Extensión: {name} (hecha para GNOME {versions}, puede que no cargue)"

#: src/core/installer.py:733
#, python-brace-format
msgid "Extension: {name} (enable it after the next login)"
msgstr "Extensión: {name} (actívala tras el próximo inicio de sesión)"

#: src/core/installer.py:784
#, python-brace-format
msgid "Font: {n} file"
msgid_plural "Font: {n} files"
msgstr[0] "Tipografía: {n} archivo"
msgstr[1] "Tipografía: {n} archivos"


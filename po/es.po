msgid ""
"The theme uses CSS that GTK does not understand ({props}). This can slow "
"down or freeze the whole session."
msgstr ""
"El tema usa CSS que GTK no entiende ({props}). Esto puede ralentizar o "
"congelar toda la sesión."

#: src/core/theme_check.py:87
msgid "The theme is missing gtk-4.0/gtk.css. GNOME would fall back to Adwaita."
msgstr ""
"Al tema le falta gtk-4.0/gtk.css. GNOME usaría Adwaita como alternativa."

#: src/core/theme_check.py:97
